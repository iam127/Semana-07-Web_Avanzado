<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'DM Sans', sans-serif; background: #f5f5f0; color: #1a1a1a; min-height: 100vh; }

        nav {
            background: #fff; border-bottom: 1px solid #e8e8e4;
            padding: 0 2rem; height: 56px;
            display: flex; align-items: center; justify-content: space-between;
        }
        .nav-brand { font-size: 0.95rem; font-weight: 600; color: #1a1a1a; letter-spacing: -0.01em; }
        .nav-right { display: flex; align-items: center; gap: 0.75rem; }
        .role-badge {
            font-size: 0.75rem; font-weight: 500;
            padding: 0.25rem 0.65rem; border-radius: 20px;
            background: #f0f0eb; color: #555; border: 1px solid #e0e0da;
        }
        .role-badge.admin { background: #1a1a1a; color: #fff; border-color: #1a1a1a; }
        .logout-btn {
            font-size: 0.82rem; font-weight: 500; color: #888;
            background: none; border: none; cursor: pointer;
            font-family: 'DM Sans', sans-serif; transition: color 0.15s;
        }
        .logout-btn:hover { color: #1a1a1a; }

        .main { max-width: 900px; margin: 0 auto; padding: 2.5rem 2rem; }

        /* Banner bienvenida */
        .welcome-banner {
            background: #1a1a1a; color: #fff;
            border-radius: 16px; padding: 2.5rem;
            margin-bottom: 1.5rem;
            display: flex; align-items: center; justify-content: space-between;
        }
        .welcome-text h1 { font-size: 1.5rem; font-weight: 600; letter-spacing: -0.02em; }
        .welcome-text p { color: #aaa; font-size: 0.875rem; margin-top: 0.4rem; }
        .welcome-avatar {
            width: 60px; height: 60px; border-radius: 50%;
            background: #333; color: #fff; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem; font-weight: 600; overflow: hidden;
        }
        .welcome-avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }

        /* Cards resumen */
        .cards-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem; margin-bottom: 1.5rem;
        }
        .card {
            background: #fff; border: 1px solid #e8e8e4;
            border-radius: 12px; padding: 1.25rem 1.5rem;
        }
        .card label {
            font-size: 0.72rem; font-weight: 600; text-transform: uppercase;
            letter-spacing: 0.07em; color: #aaa; display: block; margin-bottom: 0.4rem;
        }
        .card span { font-size: 0.95rem; font-weight: 500; color: #1a1a1a; }
        .card .mono { font-family: 'DM Mono', monospace; font-size: 0.78rem; color: #888; }

        /* Botones */
        .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
        .btn {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.85rem; font-weight: 500;
            padding: 0.6rem 1.25rem; border-radius: 8px;
            cursor: pointer; text-decoration: none;
            display: inline-flex; align-items: center; gap: 0.4rem;
            transition: opacity 0.15s;
        }
        .btn:hover { opacity: 0.8; }
        .btn-primary { background: #1a1a1a; color: #fff; border: none; }
        .btn-secondary { background: #fff; color: #1a1a1a; border: 1px solid #e0e0da; }

        /* Tabla admin */
        .table-card {
            background: #fff; border: 1px solid #e8e8e4;
            border-radius: 14px; overflow: hidden;
        }
        .table-top {
            padding: 1.25rem 1.75rem; border-bottom: 1px solid #f0f0eb;
            display: flex; align-items: center; justify-content: space-between;
        }
        .table-top h2 { font-size: 0.95rem; font-weight: 600; }
        .user-count { font-size: 0.78rem; color: #aaa; }
        table { width: 100%; border-collapse: collapse; }
        th {
            text-align: left; padding: 0.75rem 1.75rem;
            font-size: 0.72rem; font-weight: 600; text-transform: uppercase;
            letter-spacing: 0.07em; color: #aaa; background: #fafaf8;
            border-bottom: 1px solid #f0f0eb;
        }
        td { padding: 0.9rem 1.75rem; font-size: 0.875rem; border-bottom: 1px solid #f7f7f4; }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: #fafaf8; }
        .email-cell { color: #888; }
        .pill {
            display: inline-block; padding: 0.2rem 0.6rem;
            border-radius: 20px; font-size: 0.72rem; font-weight: 500;
        }
        .pill-admin { background: #1a1a1a; color: #fff; }
        .pill-user { background: #f0f0eb; color: #555; border: 1px solid #e0e0da; }
        .table-avatar {
            width: 30px; height: 30px; border-radius: 50%;
            background: #e8e8e4; color: #555;
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 0.7rem; font-weight: 600; overflow: hidden; vertical-align: middle;
            margin-right: 0.5rem;
        }
        .table-avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
        .view-btn {
            font-size: 0.78rem; color: #888; background: none; border: none;
            cursor: pointer; font-family: 'DM Sans', sans-serif;
            padding: 0.2rem 0.5rem; border-radius: 6px;
            transition: background 0.15s, color 0.15s;
        }
        .view-btn:hover { background: #f0f0eb; color: #1a1a1a; }
    </style>
</head>
<body>
    <nav>
        <span class="nav-brand">Mi App</span>
        <div class="nav-right">
            <span class="role-badge" id="role-badge"></span>
            <button class="logout-btn" onclick="logout()">Cerrar sesión</button>
        </div>
    </nav>

    <div class="main">

        <!-- Panel usuario -->
        <div id="panel-user" style="display:none;">
            <div class="welcome-banner">
                <div class="welcome-text">
                    <h1 id="welcome-title">Bienvenido 👋</h1>
                    <p>Aquí están tus datos principales</p>
                </div>
                <div class="welcome-avatar" id="welcome-avatar"></div>
            </div>

            <div class="cards-grid">
                <div class="card">
                    <label>Nombre completo</label>
                    <span id="card-name">—</span>
                </div>
                <div class="card">
                    <label>Correo</label>
                    <span id="card-email">—</span>
                </div>
                <div class="card">
                    <label>Rol</label>
                    <span id="card-role">—</span>
                </div>
                <div class="card">
                    <label>ID de cuenta</label>
                    <span class="mono" id="card-id">—</span>
                </div>
            </div>

            <div class="actions">
                <a href="/profile" class="btn btn-primary">Ver mi perfil completo</a>
                <button class="btn btn-secondary" onclick="logout()">Cerrar sesión</button>
            </div>
        </div>

        <!-- Panel admin -->
        <div id="panel-admin" style="display:none;">
            <div class="welcome-banner" style="margin-bottom:1.5rem;">
                <div class="welcome-text">
                    <h1>Panel de Administración</h1>
                    <p>Gestión de usuarios del sistema</p>
                </div>
            </div>
            <div class="table-card">
                <div class="table-top">
                    <h2>Usuarios registrados</h2>
                    <span class="user-count" id="user-count"></span>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Fecha de registro</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="users-body"></tbody>
                </table>
            </div>
        </div>

    </div>

<script>
    const token = sessionStorage.getItem('token');
    if (!token) window.location.href = '/signin';

    let payload;
    try {
        payload = JSON.parse(atob(token.split('.')[1]));
    } catch {
        sessionStorage.removeItem('token');
        window.location.href = '/signin';
    }

    // Verificar expiración del token
    if (payload.exp && Date.now() / 1000 > payload.exp) {
        sessionStorage.removeItem('token');
        window.location.href = '/signin';
    }

    const isAdmin = payload.roles && payload.roles.includes('admin');

    const badge = document.getElementById('role-badge');
    badge.textContent = isAdmin ? 'Admin' : 'Usuario';
    if (isAdmin) badge.classList.add('admin');

    if (isAdmin) {
        document.getElementById('panel-admin').style.display = 'block';
        loadUsers();
    } else {
        document.getElementById('panel-user').style.display = 'block';
        loadMe();
    }

    async function handleResponse(res) {
        if (res.status === 401) {
            sessionStorage.removeItem('token');
            window.location.href = '/signin';
            return null;
        }
        if (res.status === 403) {
            window.location.href = '/403';
            return null;
        }
        return res.json();
    }

    async function loadMe() {
        const res = await fetch('/api/users/me', {
            headers: { 'Authorization': 'Bearer ' + token }
        });
        const u = await handleResponse(res);
        if (!u) return;

        const name = ((u.name || '') + ' ' + (u.lastName || '')).trim();
        document.getElementById('welcome-title').textContent = `Bienvenido, ${u.name || 'Usuario'} 👋`;
        document.getElementById('card-name').textContent = name || '—';
        document.getElementById('card-email').textContent = u.email;
        document.getElementById('card-role').textContent = (u.roles || []).join(', ');
        document.getElementById('card-id').textContent = u.id;

        const av = document.getElementById('welcome-avatar');
        if (u.url_profile) {
            av.innerHTML = `<img src="${u.url_profile}" onerror="this.parentElement.textContent='${((u.name||'?')[0]+(u.lastName||'?')[0]).toUpperCase()}'" />`;
        } else {
            av.textContent = ((u.name || '?')[0] + (u.lastName || '?')[0]).toUpperCase();
        }
    }

    async function loadUsers() {
        const res = await fetch('/api/users', {
            headers: { 'Authorization': 'Bearer ' + token }
        });
        const users = await handleResponse(res);
        if (!users) return;

        document.getElementById('user-count').textContent = users.length + ' registrados';

        document.getElementById('users-body').innerHTML = users.map(u => {
            const initials = ((u.name || '?')[0] + (u.lastName || '?')[0]).toUpperCase();
            const avatarHtml = u.url_profile
                ? `<span class="table-avatar"><img src="${u.url_profile}" onerror="this.parentElement.textContent='${initials}'" /></span>`
                : `<span class="table-avatar">${initials}</span>`;

            const fecha = u.createdAt
                ? new Date(u.createdAt).toLocaleDateString('es-PE', { day: '2-digit', month: 'short', year: 'numeric' })
                : '—';

            return `<tr>
                <td>${avatarHtml}${(u.name || '')} ${(u.lastName || '')}</td>
                <td class="email-cell">${u.email}</td>
                <td>${(u.roles || []).map(r => `<span class="pill ${(r.name || r) === 'admin' ? 'pill-admin' : 'pill-user'}">${r.name || r}</span>`).join(' ')}</td>
                <td class="email-cell">${fecha}</td>
                <td><button class="view-btn" onclick="verUsuario('${u.id}')">Ver info</button></td>
            </tr>`;
        }).join('');
    }

    function verUsuario(id) {
        window.location.href = `/profile/${id}`;
    }

    function logout() {
        sessionStorage.removeItem('token');
        window.location.href = '/signin';
    }
</script>
</body>
</html>