<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', sans-serif;
            background: #f5f5f0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .container { width: 100%; max-width: 400px; padding: 1.5rem; }
        .logo {
            text-align: center;
            margin-bottom: 2.5rem;
        }
        .logo-mark {
            width: 44px; height: 44px;
            background: #1a1a1a;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
        }
        .logo-mark svg { width: 22px; height: 22px; fill: #fff; }
        .logo h1 { font-size: 1.25rem; font-weight: 600; color: #1a1a1a; letter-spacing: -0.02em; }
        .logo p { color: #888; font-size: 0.875rem; margin-top: 0.25rem; font-weight: 400; }
        .card {
            background: #fff;
            border-radius: 16px;
            padding: 2rem;
            border: 1px solid #e8e8e4;
        }
        .field { margin-bottom: 1.25rem; }
        .field label {
            display: block;
            font-size: 0.8rem;
            font-weight: 500;
            color: #555;
            margin-bottom: 0.5rem;
        }
        .field input {
            width: 100%;
            padding: 0.7rem 0.9rem;
            border: 1px solid #e0e0da;
            border-radius: 8px;
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            color: #1a1a1a;
            background: #fafaf8;
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }
        .field input:focus {
            border-color: #1a1a1a;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(26,26,26,0.06);
        }
        .btn {
            width: 100%;
            padding: 0.75rem;
            background: #1a1a1a;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.15s;
            margin-top: 0.25rem;
        }
        .btn:hover { background: #333; }
        .btn:active { background: #000; }
        .error-msg {
            font-size: 0.82rem;
            color: #c0392b;
            background: #fdf2f2;
            border: 1px solid #f5c6c6;
            border-radius: 7px;
            padding: 0.6rem 0.9rem;
            margin-bottom: 1rem;
            display: none;
        }
        .footer { text-align: center; margin-top: 1.5rem; font-size: 0.85rem; color: #888; }
        .footer a { color: #1a1a1a; text-decoration: none; font-weight: 500; }
        .footer a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo">
            <div class="logo-mark">
                <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            </div>
            <h1>Bienvenido</h1>
            <p>Inicia sesión en tu cuenta</p>
        </div>
        <div class="card">
            <div id="error-msg" class="error-msg"></div>
            <div class="field">
                <label>Correo electrónico</label>
                <input id="email" type="email" placeholder="correo@ejemplo.com" />
            </div>
            <div class="field">
                <label>Contraseña</label>
                <input id="password" type="password" placeholder="••••••••" onkeydown="if(event.key==='Enter') signIn()" />
            </div>
            <button class="btn" onclick="signIn()">Iniciar sesión</button>
        </div>
        <div class="footer">¿No tienes cuenta? <a href="/signup">Regístrate</a></div>
    </div>
    <script>
        async function signIn() {
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const res = await fetch('/api/auth/signIn', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
            });
            const data = await res.json();
            if (!res.ok) {
                const err = document.getElementById('error-msg');
                err.textContent = data.message;
                err.style.display = 'block';
                return;
            }
            sessionStorage.setItem('token', data.token);
            const payload = JSON.parse(atob(data.token.split('.')[1]));
            window.location.href = payload.roles.includes('admin') ? '/dashboard?role=admin' : '/dashboard?role=user';
        }
    </script>
</body>
</html>